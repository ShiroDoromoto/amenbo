{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "amenbo",
  "version": "14.0.0",
  "identifier": "work.amenbo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-cli-sidecar.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "amenbo",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: amenboblob: http://amenboblob.localhost; media-src 'self' blob: amenboblob: http://amenboblob.localhost; frame-src amenboblob: http://amenboblob.localhost; connect-src 'self' ipc: http://ipc.localhost amenboblob: http://amenboblob.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/amenbo"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMTUxMjc2NTIyQURDMUQKUldRZDNDcFNkaElWTDBZUHNYZmVOZCsyaTVld2todWV5ay9WRFZ3WDRpSHpsQy9mdnRaelNIVncK",
      "endpoints": [
        "https://github.com/ShiroDoromoto/amenbo/releases/latest/download/latest-tauri.json"
      ]
    }
  }
}
