# Linux GUI build image for amenbo (Tauri v2). Produces the AppImage inside a
# container so the mac host toolchain isn't involved. Built on Ubuntu 22.04
# for a portable-enough glibc; webkit2gtk-4.1 (Tauri 2.x) ships in 22.04's universe.
#
# The image holds only the toolchain + deps. Source is rsync'd in at run time by
# build-linux-gui.sh (never COPY'd here), so the image stays cacheable across edits.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Tauri v2 Linux build deps + AppImage tooling. webkit2gtk-4.1 (NOT 4.0) is the
# one Tauri 2.x links; libayatana-appindicator3 backs the tray; librsvg renders the
# icon; libdbus is for the notification plugin (zbus talks to the session bus).
# `file` reads the built AppImage's ELF machine back in build-linux-gui.sh's arch guard.
# `xdg-utils` supplies /usr/bin/xdg-open, which the AppImage bundler copies into the
# AppDir and refuses to build without.
#
# ibus-gtk3 and fcitx5-frontend-gtk3 are here for what they leave in this image's
# /usr/lib/*/gtk-3.0/3.0.0/immodules, not for the build itself. linuxdeploy-plugin-gtk copies
# that directory into the AppDir wholesale, re-runs gtk-query-immodules-3.0 over this image, and
# then points the bundle at the cache it wrote (GTK_IM_MODULE_FILE in apprun-hooks). Whatever
# input method module is missing here is missing from every AppImage we ship: without these two
# packages the cache held the 14 modules libgtk-3-0 carries and no ibus or fcitx5 row, so
# GTK_IM_MODULE=ibus resolved to nothing and Japanese could not be typed anywhere in the app —
# the terminal or the box. The client library each module dlopens
# (libibus-1.0.so.5, libFcitx5GClient.so.2) is deliberately NOT bundled: the module is only ever
# loaded on a machine whose input method is running, which is a machine that has that library,
# and a bundled copy would shadow a newer one over the same daemon.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl wget file ca-certificates git rsync pkg-config \
      libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev \
      libayatana-appindicator3-dev libssl-dev libdbus-1-dev libxdo-dev \
      ibus-gtk3 fcitx5-frontend-gtk3 \
      patchelf fuse3 desktop-file-utils xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Node 24 (matches .tool-versions) via NodeSource.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Rust stable via rustup (minimal profile — we only need to compile).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
