# The Worker's build is npm's; this only gives the root Makefile the verbs it calls, so
# `make worker-build` at the top of the repository reaches this part the same way.
#
# Nothing here deploys. The Worker goes into the USER's Cloudflare account, and amenbo is
# what puts it there — a deploy target reachable from the top of the repository would be an
# invitation to push it into ours by accident. `npm run deploy` is still there to do it by hand.

NPM := npm

.PHONY: build test clean install baked

# Where amenbo keeps the copy it deploys. The user's PC has no Node on it, so what stands the
# Worker up carries the built script inside its own binary — see `baked`.
BAKED := ../crates/amenbo-core/src/viewer

# `npm ci` is the install that honours the lockfile, so what CI builds is what the lockfile pins
# rather than whatever resolved today. The stamp is node_modules itself: `ci` empties and
# rewrites it, so it is newer than the lockfile exactly when it is current.
node_modules: package-lock.json
	$(NPM) ci
	@touch node_modules

install: node_modules

# `wrangler types` first, because the bindings are typed from wrangler.jsonc: one added to the
# config and not regenerated is a type error here rather than an undefined in someone's account.
build: node_modules baked
	$(NPM) run check

test: node_modules baked
	$(NPM) test

# What amenbo deploys is this source, built here and laid down where it embeds it: the script
# esbuild emits, and the migrations its runs apply. Both verbs bake it, so a src/ or a migration
# edited without the copy moving with it shows up as a dirty working tree the moment the gate
# runs — rather than as a user's account quietly getting the Worker from an older commit.
#
# **The migrations are copied one file at a time, under the names they have here.** Those names
# are what a database records having had, and they are the same names `readD1Migrations` hands
# the tests — so what amenbo writes into someone's ledger and what the tests read are one
# list, rather than two that agree until somebody renames a file.
#
# **All of it is generated. Edit src/ and migrations/, never the copies.**
baked: node_modules
	$(NPM) run bundle
	@mkdir -p $(BAKED)
	@printf '%s\n' '// Generated by `make -C worker baked` from worker/src. Edit the TypeScript, not this.' > $(BAKED)/worker.js
	@grep -v '^//# sourceMappingURL=' dist/index.js >> $(BAKED)/worker.js
	@rm -rf $(BAKED)/migrations
	@mkdir -p $(BAKED)/migrations
	@cp migrations/*.sql $(BAKED)/migrations/
	@printf '%s\n' 'Generated by `make -C worker baked` from worker/migrations. Edit those, not these.' > $(BAKED)/migrations/README.md

clean:
	rm -rf node_modules dist .wrangler worker-configuration.d.ts
