{
  "name": "amenbo-viewer-worker",
  "private": true,
  "type": "module",
  "description": "The drop box Amenbo Viewer reads from — deployed into the user's own Cloudflare account, never ours",
  "scripts": {
    "dev": "wrangler dev",
    "typegen": "wrangler types",
    "check": "wrangler types && tsc --noEmit && wrangler deploy --dry-run",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
